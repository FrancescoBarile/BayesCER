Package: BayesCER
Type: Package
Title: Bayesian Generalized Centered Erdős–Rényi Model
Version: 0.1.1
Authors@R: c(
    person("Francesco", "Barile",
          email = "francesco.barile@unimib.it",
          role = c("aut", "cre")),
    person("Sara", "Capozio",
          role = "aut"),
